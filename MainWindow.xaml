<Window x:Class="OperationsHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operations Hub" Width="1180" Height="900" MinWidth="820" MinHeight="720"
        Closing="Window_Closing"
        Background="#FFF7FA" Foreground="#45343D">
    <Window.Resources>
        <SolidColorBrush x:Key="Pink" Color="#FFB6D2"/>
        <SolidColorBrush x:Key="PinkLight" Color="#FFF0F6"/>
        <SolidColorBrush x:Key="PinkBorder" Color="#F0D4E0"/>
        <SolidColorBrush x:Key="Ink" Color="#45343D"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Pink}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFA2C6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="Background" Value="#FFFFFE"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PinkBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#FFFFFE"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PinkBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="230"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="YOUR SPACE TO FOCUS" Foreground="#A35D7A" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Text="Operations Hub" FontSize="32" FontWeight="SemiBold" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PinkLight}" BorderBrush="{StaticResource PinkBorder}"
                BorderThickness="1" CornerRadius="20" Padding="24" Margin="0,0,0,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="txtTimerStatus" Text="FOCUS TIMER" Foreground="#A35D7A" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtTimer" Text="25:00" FontSize="76" FontWeight="Light" Margin="0,2,0,4"/>
                    <TextBlock Text="A little focus goes a long way." Foreground="#806D76" FontSize="14"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button x:Name="btnTimerToggle" Content="Start" Click="Timer_Click" MinWidth="110"/>
                    <Button Content="Reset" Click="Reset_Click" MinWidth="95" Background="#FFE1EC"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <Border Padding="20" Background="#FFFFFE" BorderBrush="{StaticResource PinkBorder}" BorderThickness="1" CornerRadius="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Instruction" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Keep the links you need close at hand." Foreground="#806D76" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtInstructionLink" Grid.Column="0" Margin="0,0,8,0"
                                 VerticalContentAlignment="Center" ToolTip="Paste a link starting with https://"
                                 KeyDown="InstructionLink_KeyDown"/>
                        <Button Grid.Column="1" Content="Add link" Click="AddInstruction_Click"/>
                    </Grid>
                    <ListBox x:Name="lstInstructions" Grid.Row="2" DisplayMemberPath="Url"/>
                    <WrapPanel Grid.Row="3" Margin="0,14,0,0">
                        <Button Content="Open link" Click="OpenInstruction_Click"/>
                        <Button Content="Remove" Click="RemoveInstruction_Click" Background="#FFE1EC"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="20" Background="#FFFFFE" BorderBrush="{StaticResource PinkBorder}" BorderThickness="1" CornerRadius="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.8*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,16">
                        <TextBlock Text="Notes" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Create a notepad, then select it to write." Foreground="#806D76" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="lstNotes" Grid.Row="1" DisplayMemberPath="Title"
                             SelectionChanged="Notes_SelectionChanged"/>
                    <StackPanel Grid.Column="2" Grid.Row="1">
                        <TextBlock Text="TITLE" Foreground="#A35D7A" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtNoteTitle" Margin="0,0,0,12" IsEnabled="False"
                                 ToolTip="Give this notepad a title" TextChanged="NoteEditor_TextChanged"
                                 LostFocus="NoteEditor_LostFocus"/>
                        <TextBlock Text="YOUR NOTE" Foreground="#A35D7A" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtNoteContent" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" MinHeight="100" IsEnabled="False"
                                 TextChanged="NoteEditor_TextChanged" LostFocus="NoteEditor_LostFocus"/>
                    </StackPanel>
                    <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,14,0,0">
                        <Button Content="New note" Click="AddNote_Click"/>
                        <Button Content="Remove note" Click="RemoveNote_Click" Background="#FFE1EC"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
