<Window x:Class="OperationsHub.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Operations Hub" Width="1120" Height="850" MinWidth="900" MinHeight="780"
 Background="#071820" Foreground="#EDF8FA">
 <!-- XAML builds the visible window. C# adds the actions. Keep x:Class matched to the namespace. -->
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#EBD092"/><Setter Property="Foreground" Value="#10232C"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,8,8"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Background" Value="#F2F7F5"/><Setter Property="Foreground" Value="#10232C"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#E9F2F3"/><Setter Property="Foreground" Value="#10232C"/></Style>
 </Window.Resources>
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="CS110 / WEEK 8 / YOUR UTILITY" Foreground="#F1C66F"/><TextBlock Text="Operations Hub" FontSize="34" Margin="0,8"/>
   <!-- TODO: add your user and story context to this subtitle. -->
   <TextBlock Text="Plan the need. Build one action. Test the result." Foreground="#B5CED5"/></StackPanel>
  <Grid Grid.Row="1" Margin="0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
   <Border Padding="20" BorderBrush="#315D69" BorderThickness="1" CornerRadius="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Task or inventory item"/>
    <TextBox x:Name="txtEntry" Grid.Row="1" Margin="0,8,0,12"/>
    <!-- DATA HAT: bind this list to the collection during Action 8A. -->
    <ListBox x:Name="lstItems" Grid.Row="2"/>
    <WrapPanel Grid.Row="3" Margin="0,14,0,0"><Button Content="Add" Click="Add_Click"/><Button Content="Remove selected" Click="Remove_Click"/></WrapPanel></Grid></Border>
   <Border Grid.Column="2" Padding="20" Background="#102A35" CornerRadius="14"><Grid><Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <!-- TODO: load your PNG/JPG into these named images in the Artwork chapter. -->
    <Image x:Name="imgArtwork" Stretch="Uniform"/>
    <Grid Grid.Row="1" Margin="0,18,0,0"><StackPanel><TextBlock Text="FOCUS TIMER" Foreground="#F1C66F"/><TextBlock x:Name="txtTimer" Text="25:00" FontSize="48"/><WrapPanel><Button Content="Start / Pause" Click="Timer_Click"/><Button Content="Reset" Click="Reset_Click"/></WrapPanel><TextBlock Text="Team contract or work report" Margin="0,18,0,8"/><TextBox x:Name="txtDocument" Height="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel></Grid>
   </Grid></Border>
  </Grid>
  <StackPanel Grid.Row="2"><WrapPanel>
   <!-- An image inside a button does not change how Click works. -->
   <Button Click="Image_Click"><StackPanel Orientation="Horizontal"><Image x:Name="imgButton" Width="28" Height="28" Margin="0,0,8,0"/><TextBlock Text="Choose artwork" VerticalAlignment="Center"/></StackPanel></Button>
   <Button Content="Export contract" Click="Save_Click"/><Button Content="Reopen text" Click="Open_Click"/>
  </WrapPanel><TextBlock x:Name="txtStatus" Text="Raw starter: follow the tutorial to add each behavior." Foreground="#95E6EF" TextWrapping="Wrap"/></StackPanel>
 </Grid>
</Window>